{
  "name": "river",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/river.git"
  },
  "bugs": {
    "url": "https://github.com/vectojs/river/issues"
  },
  "homepage": "https://github.com/vectojs/river#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\" \"e2e/**/*.{js,ts}\"",
    "lint": "oxlint --deny-warnings src test e2e",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\" \"e2e/**/*.{js,ts}\"",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vectojs/core": "1.40.1",
    "@vectojs/markdown": "0.25.1",
    "@vectojs/river-core": "0.1.0",
    "@vectojs/styles": "0.3.3",
    "@vectojs/ui": "2.21.0",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@vectojs/devtools": "0.11.2",
    "carryctx": "0.11.6",
    "lefthook": "^2.1.17",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "^4.147.0"
  }
}
